# 复制成 .env 再填（.env 已在 .gitignore 里，不会被提交）
#   cp .env.example .env
#
# 两条路共用这份配置：
#   ① 自带运行时：./study            直接读这里
#   ② Claude Code 换后端：python3 shared/工具/切换模型.py   把这里的配置写进 .claude/settings.local.json

# 预设名，见 shared/模型预设.json：deepseek · kimi · glm · qwen · openai · openrouter · anthropic · ollama
STUDY_PROVIDER=deepseek

# 你的 API key（ollama 不需要）
STUDY_API_KEY=

# 可选：模型名。不填就用预设里的默认值；预设没给默认值的厂商（glm · qwen · openai · openrouter · ollama）必须填
STUDY_MODEL=

# 可选：轻量任务用的小模型（Claude Code 的 Haiku 档 · 行动项审计）
STUDY_SMALL_MODEL=

# 可选：不用预设，自己指定 OpenAI 兼容的地址（填了就覆盖预设）
STUDY_BASE_URL=

# 可选：关掉流式输出（个别中转服务的流式有问题时用）
# STUDY_STREAM=0
